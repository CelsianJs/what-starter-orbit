{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": {
        "Cache-Control": "private, no-store"
      }
    },
    {
      "source": "/services",
      "headers": {
        "Cache-Control": "public, max-age=300, stale-while-revalidate=900"
      }
    },
    {
      "source": "/reservations",
      "headers": {
        "Cache-Control": "private, no-store"
      }
    },
    {
      "source": "/build",
      "headers": {
        "Cache-Control": "public, max-age=600"
      }
    }
  ]
}
